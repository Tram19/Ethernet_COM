{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/SleepMode.elf",
      
      "servertype": "stlink", 
      
      "serverpath": "/opt/st/stm32cubeide_2.1.1/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.linux64_2.2.400.202601091506/tools/bin/ST-LINK_gdbserver",
      
      "gdbPath": "/usr/bin/gdb-multiarch",
      "runToEntryPoint": "main",
      "showDevDebugOutput": true
    }
  ]
}